AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Use the AWS SDK default credential provider chain.
# Do not commit access keys or secrets.
# Local development may use an AWS profile / SSO / least-privilege credentials.

# Ring Playground / sandbox configuration.
# Keep real OAuth access tokens in your local environment only.
RING_API_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
RING_DEVICES_PATH=/v1/devices
# Optional. Configure this only when the Playground exposes an events listing path.
RING_EVENTS_PATH=

# Local preview (loopback only). No SDP file needed.
RING_PREVIEW_PORT=3001
