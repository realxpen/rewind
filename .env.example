AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Use the AWS SDK default credential provider chain.
# Do not commit access keys or secrets.
# Local development may use an AWS profile / SSO / least-privilege credentials.

# Phase 4 persistence.
DYNAMODB_CHECKPOINTS_TABLE=rewind-checkpoints-dev

# Ring Playground / sandbox configuration.
# Keep real OAuth access tokens and HMAC secrets in your local environment only.
RING_API_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
RING_DEVICES_PATH=/v1/devices
# Optional. Configure this only when the Playground exposes an events listing path.
RING_EVENTS_PATH=

# Phase 7 signed Ring webhook verification.
# Obtain the HMAC signing key from your Ring app credentials; never commit the real value.
RING_HMAC_SECRET=
# Local ingress listens on 127.0.0.1:3003. Expose only /webhooks/ring through HTTPS TLS 1.2+.
# Register the resulting public HTTPS URL in the Ring Developer Portal.

# Local preview (loopback only). No SDP file needed.
RING_PREVIEW_PORT=3002
