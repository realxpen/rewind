AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Use the AWS SDK default credential provider chain.
# Do not commit access keys or secrets.
# Local development may use an AWS profile / SSO / least-privilege credentials.

# Phase 4 persistence.
DYNAMODB_CHECKPOINTS_TABLE=rewind-checkpoints-dev

# Ring Playground / sandbox configuration.
# Keep real OAuth access tokens and HMAC secrets in your local environment only.
RING_API_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
RING_DEVICES_PATH=/v1/devices
# Optional. Configure this only when the Playground exposes an events listing path.
RING_EVENTS_PATH=

# Phase 7 Ring app credentials. These are issued by Ring and must never be committed.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SECRET=

# Staging-only REWIND identity used to satisfy Ring's mandatory partner sign-in step.
# The email identifies the REWIND user claiming the Ring connection.
REWIND_LINK_USER_EMAIL=
# Use a unique random secret with at least 16 characters. Do not reuse a real account password.
REWIND_LINK_AUTH_SECRET=

# Local Ring integration listener. One HTTPS tunnel hostname can serve all four required Ring URLs:
#   /ring/link                  Account Link URL
#   /ring                       App Homepage URL
#   /ring/oauth/token-exchange  Token Exchange URL
#   /webhooks/ring              Webhook URL
RING_WEBHOOK_PORT=3003

# Local preview (loopback only). No SDP file needed.
RING_PREVIEW_PORT=3002

# Phase 8 Strands + AgentCore.
# Nova 2 Lite remains the conversational orchestration model; deterministic REWIND code remains physical truth.
REWIND_AGENT_MODEL_ID=global.amazon.nova-2-lite-v1:0
# AgentCore Memory ID for short-term session continuity. Leave blank to use the in-memory fixture fallback.
REWIND_AGENTCORE_MEMORY_ID=
# Non-secret identifiers used to resume the same conversational session.
REWIND_AGENT_ACTOR_ID=rewind-demo-user
REWIND_AGENT_SESSION_ID=rewind-demo-session
