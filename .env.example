AWS_PROFILE=rewind-dev
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_SDK_LOAD_CONFIG=1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Use the AWS SDK default credential provider chain.
# Do not commit access keys or secrets.
# Local development uses the least-privilege rewind-dev profile; refresh it with:
#   aws login --profile rewind-dev

# Phase 4 persistence.
DYNAMODB_CHECKPOINTS_TABLE=rewind-checkpoints-dev

# Ring Playground / sandbox configuration.
# Keep real OAuth access tokens and HMAC secrets in your local .env only.
RING_API_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
RING_DEVICES_PATH=/v1/devices
RING_EVENTS_PATH=

RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SECRET=

REWIND_LINK_USER_EMAIL=
REWIND_LINK_AUTH_SECRET=

RING_WEBHOOK_PORT=3003
RING_PREVIEW_PORT=3002

REWIND_AGENT_MODEL_ID=global.amazon.nova-2-lite-v1:0
REWIND_DEFAULT_SPACE_ID=ring-playground
REWIND_AGENTCORE_MEMORY_ID=
REWIND_AGENT_ACTOR_ID=rewind-demo-user
REWIND_AGENT_SESSION_ID=rewind-ring-live-01

REWIND_MCP_PORT=3004
REWIND_MCP_ACTOR_ID=rewind-mcp-demo-user
REWIND_MCP_SESSION_ID=rewind-mcp-live-02
REWIND_MCP_OBSERVATION_TIMEOUT_MS=60000
# Voice/MCP fresh visual evidence.
# "auto" tries one server-side RTSPS frame, then permanently falls back to the live WHEP browser bridge if RTSPS is unavailable.
# Other modes: rtsp, snapshot (historical media), browser.
REWIND_RING_OBSERVER=auto
# Optional: pin the Ring camera used for Alexa/MCP. If blank, REWIND uses the first discovered device.
REWIND_RING_DEVICE_ID=
# Optional multi-camera module ID from Ring capabilities.
REWIND_RING_COMPONENT_ID=
# Local FFmpeg binary used only for one-frame RTSPS capture.
REWIND_FFMPEG_PATH=ffmpeg
REWIND_RING_RTSP_TIMEOUT_MS=18000
# Buffered WHEP fallback keeps only the newest browser-decoded JPEG in RAM.
REWIND_RING_WHEP_FRAME_MAX_AGE_MS=5000
REWIND_RING_WHEP_FRAME_WAIT_MS=12000
# Snapshot fallback search window for the most recent Ring JPEG.
REWIND_RING_SNAPSHOT_LOOKBACK_MS=900000
REWIND_MCP_PUBLIC_HOST=

# Standard Alexa Custom Skill (hackathon voice surface; separate from Alexa+).
REWIND_ALEXA_SKILL_ID=
REWIND_ALEXA_PORT=3005
# Shared secret used only by the Lambda -> local REWIND relay.
# Generate a long random value locally and never commit the real value.
REWIND_ALEXA_RELAY_SECRET=

# Lambda environment variables (set in AWS Lambda, not in local .env):
# REWIND_RELAY_URL=https://<your-ngrok-host>/alexa-relay
# REWIND_RELAY_SECRET=<same secret as REWIND_ALEXA_RELAY_SECRET>
# REWIND_ALEXA_SKILL_ID=<same Alexa Skill ID>
