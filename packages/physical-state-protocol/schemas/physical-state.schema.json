{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/realxpen/rewind/packages/physical-state-protocol/schemas/physical-state.schema.json",
  "title": "REWIND Physical State Protocol v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spaceId", "capturedAt", "entities"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "spaceId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "category", "confidence"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["ON", "UNDER", "INSIDE", "LEFT_OF", "RIGHT_OF", "BEHIND", "IN_FRONT_OF", "NEAR", "ATTACHED_TO", "OPEN", "CLOSED", "ON_STATE", "OFF_STATE", "CLEAR", "OCCUPIED"]
                },
                "target": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
